# Simplifyr environment configuration.
# Copy to `.env` and adjust. Never commit real secrets.

# --- Database ---
# SQLite (default, dev):
DATABASE_URL=sqlite:///./simplifyr.db
# PostgreSQL (production): postgresql+psycopg2://user:pass@host:5432/simplifyr

# --- Runtime ---
RAW_STORAGE_DIR=./data/raw
SYSLOG_ENABLED=true
SYSLOG_UDP_HOST=127.0.0.1
SYSLOG_UDP_PORT=5514
# Newline-delimited syslog over TCP (opt-in; same pipeline envelope as UDP)
SYSLOG_TCP_ENABLED=false
SYSLOG_TCP_HOST=127.0.0.1
SYSLOG_TCP_PORT=5515
# Tail a log file into the pipeline (opt-in; offset persisted per process run)
FILE_WATCH_ENABLED=false
FILE_WATCH_PATH=./data/inbox/app.log
FILE_WATCH_INTERVAL_SECONDS=1.0
# External Kafka topic ingress (opt-in; requires kafka-python)
KAFKA_INGRESS_ENABLED=false
KAFKA_INGRESS_TOPIC=external.logs
KAFKA_INGRESS_GROUP=simplifyr-ingress
# Horizontal scaling: pipeline worker consumers + in-memory buffer cap
PIPELINE_WORKERS=1
PIPELINE_MAX_QUEUE=10000

# --- Kafka (requires kafka-python; see backend/requirements-scale.txt) ---
# PIPELINE_BACKEND=kafka switches the transport from in-memory to Kafka.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_RAW=simplifyr.raw
KAFKA_TOPIC_OUTPUT=simplifyr.output
# Stage bus (§35): parsed/normalized/quarantine/drift/dlq mirror KAFKA_TOPIC_* names

# --- AI / Intelligence ---
# "heuristic" (offline/deterministic), "ollama" (local LLM),
# "groq"/"gemini" (cloud demo keys, rotated with per-key cooldown)
AI_PROVIDER=heuristic
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
# Comma-separated demo keys (5 recommended); never commit real keys.
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash

# --- Limits (single-user tool: API is open, no accounts) ---
# Requests per minute allowed on ingest (0 = unlimited)
RATE_LIMIT_PER_MINUTE=0
# Honor X-Forwarded-For/X-Real-IP only when behind a known proxy (nginx in compose)
TRUST_PROXY_HEADERS=false
# Max bytes served by GET /events/{id}/raw (larger payloads: 413, use export)
MAX_RAW_BYTES=1000000

# --- Retention (0 = disabled; tiered per product §59, recommended 30/90/365) ---
RETENTION_DAYS=0
RAW_RETENTION_DAYS=0
NORMALIZED_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=0
RETENTION_INTERVAL_SECONDS=3600