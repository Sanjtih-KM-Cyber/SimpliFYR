[
  {
    "id": "fw-syslog-v1",
    "source": "VendorX FirewallY",
    "format": "syslog",
    "version": "v1",
    "event_family": "network_traffic",
    "raw": "<134>Sep 15 10:31:44 fw01 srcip=10.1.1.5 dstip=8.8.8.8 proto=tcp action=deny",
    "expected_semantic": {
      "srcip": "source.ip",
      "dstip": "destination.ip",
      "proto": "network.protocol",
      "action": "network.action"
    }
  },
